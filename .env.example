# Las credenciales de la cuenta de servicio estan integradas en el codigo
# (src/lib/google-drive.ts). No se necesitan variables de entorno para Google.

# URL publica HTTPS, sin barra final: https://dashboard.example.com
APP_URL=https://dashboard.example.com

# Secretos aleatorios distintos, de 32 bytes o mas.
DRIVE_WEBHOOK_TOKEN=replace-with-a-random-secret
SYNC_ADMIN_SECRET=replace-with-a-different-random-secret
