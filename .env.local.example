# Keep real values only in .env.local (ignored by Git) or in Netlify environment variables.
# Never commit a Google service-account JSON or private key.
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT","private_key":"-----BEGIN PRIVATE KEY-----\\nREPLACE_ME\\n-----END PRIVATE KEY-----\\n","client_email":"service-account@YOUR_PROJECT.iam.gserviceaccount.com"}
DRIVE_WEBHOOK_TOKEN=replace-with-a-random-secret
SYNC_ADMIN_SECRET=replace-with-a-different-random-secret
APP_URL=https://your-site.netlify.app
