# ===========================================
# Configuracion de Google Service Account
# ===========================================
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un proyecto o selecciona uno existente
# 3. Activa Google Drive API
# 4. Ve a "IAM y Administracion" > "Cuentas de servicio"
# 5. Crea una cuenta de servicio (rol: Lector)
# 6. Genera una clave JSON y descargala
# 7. Copia TODO el contenido del JSON AQUI (en una sola linea)
# 8. Comparte la carpeta de Drive con el email de la cuenta de servicio

GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/...%40....iam.gserviceaccount.com"}

# ID de la carpeta de Google Drive (por defecto la de Control_Tienda)
# GOOGLE_DRIVE_FOLDER_ID=1-1MZ4tSLIwz_8qODXebbFLhKR09VqyiR
